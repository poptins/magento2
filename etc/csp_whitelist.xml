<?xml version="1.0" encoding="UTF-8"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="poptin_cdn" type="host">*.popt.in</value>
                <value id="poptin_cloudflare" type="host">*.cloudflare.com</value>
                <value id="poptin_jsdelivr" type="host">*.jsdelivr.net</value>
            </values>
        </policy>
         <policy id="style-src">
            <values>
                <value id="poptin_cdn" type="host">*.popt.in</value>
                <value id="poptin_cloudflare" type="host">*.cloudflare.com</value>
                <value id="poptin_jsdelivr" type="host">*.jsdelivr.net</value>
                <value id="poptin_aws_fonts" type="host">*.on.aws</value>
                <value id="poptin_s3" type="host">*.amazonaws.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="poptin_cdn" type="host">*.popt.in</value>
                <value id="poptin_cloudfront" type="host">*.cloudfront.net</value>
            </values>
        </policy>
         <policy id="font-src">
            <values>
                <value id="poptin_cloudflare" type="host">*.cloudflare.com</value>
                <value id="poptin_cdn" type="host">*.popt.in</value>
                <value id="poptin_s3" type="host">*.amazonaws.com</value>
                <value id="poptin_aws_fonts" type="host">*.on.aws</value>
                <value id="poptin_cloudfront" type="host">*.cloudfront.net</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="poptin_cloudfront" type="host">*.cloudfront.net</value>
                <value id="poptin_cloudflare" type="host">*.cloudflare.com</value>
                <value id="poptin_cdn" type="host">*.popt.in</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>